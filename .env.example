# OpenAI API Key (Optional)
OPENAI_API_KEY=

# OpenAI Models (Optional - defaults provided)
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini (Optional)
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-flash-lite-latest

# NVIDIA Embeddings (Optional)
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic (Optional)
ANTHROPIC_API_KEY=

# Database (Configured in docker-compose.yml)
DATABASE_URL=postgresql://funduser:fundpass@postgres:5432/funddb

# Redis (Configured in docker-compose.yml)
REDIS_URL=redis://redis:6379/0

# LLM selection (auto | groq | openai | gemini | ollama)
LLM_PROVIDER=auto
SIMILARITY_THRESHOLD=0.2

# xAI Grok (for MCP/agent backends)
GROK_API_KEY=
GROK_MODEL=openai/gpt-oss-20b
GROK_BASE_URL=https://api.groq.com/openai/v1

